# ==============================================
# Resume & Interview Analysis App 环境配置示例
# 使用方式: 复制本文件为 .env 并填入真实值
#   cp .env.example .env
# ==============================================

# ---------- LLM / ASR (DashScope 阿里云，必需) ----------
# 主模型用于面试分析 / 报告生成
DASHSCOPE_API_KEY=your_dashscope_api_key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3-max
# ASR 语音转文字模型
QWEN_ASR_MODEL_NAME=qwen3-asr-flash
QWEN_EMBEDDING_MODEL_NAME=text-embedding-v3
QWEN_OCR_MODEL_NAME=qwen-vl-ocr-latest
DSC_API_URL=https://dashscope.aliyuncs.com/api/v1
# LLM 请求超时（秒）
LLM_TIMEOUT=240

# ---------- 邮件 (QQ SMTP，报告发送，必需) ----------
SENDER_EMAIL=your_qq@qq.com
EMAIL_PASSWORD=your_qq_smtp_auth_code

# ---------- MySQL (可选，Base 框架自动注册；连不上只告警不影响运行) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database
DB_CHARSET=utf8mb4
BASE_DB_NAME=base_database

# ---------- Redis (缓存，可选) ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---------- Milvus 向量库 (可选) ----------
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TIMEOUT=10
MILVUS_COLLECTION_NAME=demo_collection
VECTOR_DIM=768
MILVUS_SECURE=False
MILVUS_ALIAS=default

# ---------- MinIO 对象存储 (报告/转写文本，可选) ----------
MINIO_ACCESS_KEY=your_minio_key
MINIO_SECRET_KEY=your_minio_secret
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ASR_TEXT_BUCKET_NAME=audio-text

# ---------- ffmpeg (音频处理，必需) ----------
# 指向包含 ffmpeg.exe / ffprobe.exe 的目录；可通过 pip install static-ffmpeg 安装
# Windows 示例:
FFMPEG_PATH=
# Linux 示例:
# FFMPEG_PATH=/usr/bin

# ---------- 日志 ----------
LOG_LEVEL=INFO
